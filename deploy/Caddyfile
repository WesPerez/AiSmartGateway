    email {$ACME_EMAIL}
}

{$DOMAIN} {
    encode gzip zstd

    @api path /v1/* /models /models/* /chat/completions /responses /embeddings /audio/* /images/* /moderations /completions
    reverse_proxy @api smart-gateway:8000

    @health path /health
    reverse_proxy @health smart-gateway:8000

    @admin path /admin/*
    reverse_proxy @admin smart-gateway:8000

    respond / 200 {
        body "AI Smart Gateway OK"
    }
}
