[Unit]
Description=Sync New API gateway-source channels into AI Smart Gateway
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/ai-smart-gateway-sync-newapi
WorkingDirectory=/opt/AiSmartGateway
ExecStart=/opt/AiSmartGateway/scripts/sync-newapi-router.py --db ${NEWAPI_DB} --router-groups ${ROUTER_GROUPS} --gateway-url ${GATEWAY_URL} --no-backup --force-reload
