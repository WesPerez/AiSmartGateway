DOMAIN=api.example.com
TZ=Asia/Shanghai
ACME_EMAIL=admin@example.com

MASTER_API_KEY=change-me-master-api-key
ADMIN_TOKEN=change-me-admin-token

PROBE_INTERVAL_SECONDS=300
PROBE_TIMEOUT_SECONDS=12
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES_PER_REQUEST=8
MIN_HEALTHY_PROVIDERS=1
ENABLE_RESPONSES_PROBE=true
PROBE_ON_STARTUP=true
MODELS_REFRESH_SECONDS=3600
PROBE_MAX_PER_CYCLE=12
PROBE_SUCCESS_TTL_SECONDS=21600
PROBE_UNSUPPORTED_TTL_SECONDS=86400
PROBE_AUTH_TTL_SECONDS=3600
PROBE_QUOTA_TTL_SECONDS=3600
PROBE_RATE_LIMIT_TTL_SECONDS=1800
PROBE_SERVER_ERROR_TTL_SECONDS=900
PROBE_EXCEPTION_TTL_SECONDS=900
PROBE_UNKNOWN_ERROR_TTL_SECONDS=1800
PROBE_LOW_SIGNAL_TTL_SECONDS=900
PROBE_CONTENT_QUALITY_CHECK=true
PROBE_MIN_QUALITY_SCORE=80

UPSTREAM_X666_KEY=
UPSTREAM_ANYROUTER_KEY=
UPSTREAM_EQING_KEY=
UPSTREAM_MUYUAN_KEY=
UPSTREAM_SHAREDCHAT_KEY=
UPSTREAM_VOLCES_KEY=

# Optional HTTP(S) proxy used only for sharedchat/codex upstream traffic.
# Set this to a mainland-China proxy when new.sharedchat.cc/codex blocks non-mainland IPs.
GATEWAY_SHAREDCHAT_PROXY_URL=

# Path to the New API data directory containing one-api.db.
# For Docker named volumes, set this to the host path of that volume.
NEWAPI_DATA_DIR=/path/to/new-api-data
